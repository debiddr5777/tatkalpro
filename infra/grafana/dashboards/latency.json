{
  "title": "TatkalPro — Booking Latency",
  "uid": "tatkalpro-latency",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Request arrival vs T-0 (ms) — lower is better",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(tatkalpro_booking_arrival_delta_ms_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "title": "Booking attempt duration by stage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum(rate(tatkalpro_booking_attempt_duration_seconds_bucket[5m])) by (le, stage))"
        }
      ]
    },
    {
      "title": "Captcha accuracy",
      "type": "gauge",
      "targets": [{ "expr": "tatkalpro_captcha_accuracy_ratio" }]
    },
    {
      "title": "Active sessions",
      "type": "stat",
      "targets": [{ "expr": "tatkalpro_session_active_count" }]
    },
    {
      "title": "Queue depth",
      "type": "timeseries",
      "targets": [{ "expr": "tatkalpro_queue_depth{queue!=\"\"}" }]
    }
  ]
}
